            ss >> species; // "hyena,"
            species.pop_back(); // Remove comma

            // Calculate Birthday and ID
            string birthday = genBirthDay(age, line);
            string id = genUniqueID(species, speciesCount);
            
            // Assign Name
            string name = "Unknown";
            if (!nameLists[species].empty()) {
                name = nameLists[species][nameIndex[species] % nameLists[species].size()];
                nameIndex[species]++;
            }

            // Object Creation
            Animal* a;
            if (species == "hyena") a = new Hyena();
            else if (species == "lion") a = new Lion();
            else if (species == "tiger") a = new Tiger();
            else a = new Bear();

            // Populate attributes (Simplified extraction for color/weight/origin)
            a->setID(id);
            a->setName(name);
            a->setBirthDate(birthday);
            a->setSex(sex);
            a->setArrivalDate(getCurrentDate());
            
            // Find and set color/weight manually or via string search for robustness
            size_t colorPos = line.find("color");
            if (colorPos != string::npos) a->setColor(line.substr(colorPos - 4, 10)); // Simplified
            
            zoo.push_back(a);
        }
        animalFile.close();

        // 3. Generate Report (zooPopulation.txt)
        ofstream report("zooPopulation.txt");
        string habitats[] = {"hyena", "lion", "tiger", "bear"};
        
        for (string h : habitats) {
            string title = h;
            title[0] = toupper(title[0]);
            report << title << " Habitat:" << endl;
            for (Animal* a : zoo) {
                // Check if animal belongs in this habitat
                string speciesCheck = h;
                if (a->getReportLine().find(h.substr(0,2)) != string::npos) { // Logic check via ID prefix
                     report << "  " << a->getReportLine() << endl;
                }
            }
            report << endl;
        }
        report.close();
        
        cout << "Report generated successfully in zooPopulation.txt" << endl;

    } catch (const exception& e) {
        cerr << "Error: " << e.what() << endl;
    }

    // Cleanup
    for (Animal* a : zoo) delete a;

