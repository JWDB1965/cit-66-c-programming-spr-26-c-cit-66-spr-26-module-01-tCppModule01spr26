#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <map>
#include <sstream>
#include <algorithm>

// --- Base Class ---
class Animal {
protected:
    std::string name;
    int age;
    std::string species;

public:
    // Constructor
    Animal(std::string n, int a, std::string s) : name(n), age(a), species(s) {}
    
    // Virtual destructor: Essential for deleting subclasses via base pointers
    virtual ~Animal() {}

    // Getters and Setters
    std::string getName() const { return name; }
    void setName(std::string n) { name = n; }
    
    int getAge() const { return age; }
    void setAge(int a) { age = a; }
    
    std::string getSpecies() const { return species; }

    // Pure virtual function: Makes this an Abstract Class
    virtual std::string getHabitat() const = 0;
};

// --- Subclasses ---
class Hyena : public Animal {
public:
    Hyena(std::string n, int a) : Animal(n, a, "Hyena") {}
    std::string getHabitat() const override { return "Hyena Habitat"; }
};

class Lion : public Animal {
public:
    Lion(std::string n, int a) : Animal(n, a, "Lion") {}
    std::string getHabitat() const override { return "Lion Habitat"; }
};

class Tiger : public Animal {
public:
    Tiger(std::string n, int a) : Animal(n, a, "Tiger") {}
    std::string getHabitat() const override { return "Tiger Habitat"; }
};

class Bear : public Animal {
public:
    Bear(std::string n, int a) : Animal(n, a, "Bear") {}
    std::string getHabitat() const override { return "Bear Habitat"; }
};

// --- Helper Function: String Parsing ---
// This handles the "4 year old female hyena..." formatting
Animal* createAnimalFromLine(const std::string& line) {
    std::stringstream ss(line);
    int age;
    std::string temp;
    
    // Simple parse: extract first word as age
    ss >> age; 
    
    // Search the whole line for the species keywords
    std::string lowerLine = line;
    std::transform(lowerLine.begin(), lowerLine.end(), lowerLine.begin(), ::tolower);

    if (lowerLine.find("hyena") != std::string::npos) return new Hyena("Kamari", age);
    if (lowerLine.find("lion") != std::string::npos) return new Lion("Kiara", age);
    if (lowerLine.find("tiger") != std::string::npos) return new Tiger("Shere Khan", age);
    if (lowerLine.find("bear") != std::string::npos) return new Bear("Baloo", age);
    
    return nullptr;
}

// --- Main Program ---
int main() {
    std::vector<Animal*> zooInventory;
    std::map<std::string, int> speciesStats;

    // 1. File Input
    std::ifstream inputFile("arrivingAnimals.txt");
    if (!inputFile) {
        std::cerr << "Error: Create 'arrivingAnimals.txt' before running." << std::endl;
        return 1;
    }

    std::string line;
    while (std::getline(inputFile, line)) {
        if (line.empty()) continue;
        
        Animal* newArrival = createAnimalFromLine(line);
        if (newArrival) {
            zooInventory.push_back(newArrival);
            speciesStats[newArrival->getSpecies()]++;
        }
    }
    inputFile.close();

    // 2. File Output (The Report)
    std::ofstream outputFile("newAnimals.txt");
    outputFile << "--- Zoo Population Report ---\n\n";

    // Use a nested loop to group by species
    for (auto const& [species, count] : speciesStats) {
        outputFile << species << " Habitat (Total: " << count << ")\n";
        outputFile << "----------------------------\n";
        
        for (Animal* a : zooInventory) {
            if (a->getSpecies() == species) {
                outputFile << "Name: " << a->getName() << " | Age: " 
                           << a->getAge() << " | Enclosure: " << a->getHabitat() << "\n";
            }
        }
        outputFile << "\n";
    }
    
    outputFile.close();
    std::cout << "Report generated successfully in newAnimals.txt" << std::endl;

    // 3. Memory Cleanup (Crucial for C++)
    for (Animal* a : zooInventory) {
        delete a;
    }

    return 0;
}
