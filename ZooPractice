#include <iostream>
#include <string>
#include <vector>
#include <map>
#include <fstream>
#include <sstream>

// Base Class
class Animal {
protected:
    std::string name;
    int age;
    std::string species;

public:
    Animal(std::string n, int a, std::string s) : name(n), age(a), species(s) {}
    virtual ~Animal() {} // Virtual destructor for proper cleanup

    // Getters
    std::string getName() const { return name; }
    int getAge() const { return age; }
    std::string getSpecies() const { return species; }

    // Pure virtual function makes this an abstract base class
    virtual std::string getOrigin() const = 0; 
};

// Subclasses
class Hyena : public Animal {
public:
    Hyena(std::string n, int a) : Animal(n, a, "Hyena") {}
    std::string getOrigin() const override { return "Africa/Asia"; }
};

class Lion : public Animal {
public:
    Lion(std::string n, int a) : Animal(n, a, "Lion") {}
    std::string getOrigin() const override { return "Sub-Saharan Africa"; }
};

class Tiger : public Animal {
public:
    Tiger(std::string n, int a) : Animal(n, a, "Tiger") {}
    std::string getOrigin() const override { return "Asia"; }
};

class Bear : public Animal {
public:
    Bear(std::string n, int a) : Animal(n, a, "Bear") {}
    std::string getOrigin() const override { return "Global/North America"; }
};
int main() {
    std::vector<Animal*> zoo;
    std::map<std::string, int> speciesCount;

    std::ifstream inFile("arrivingAnimals.txt");
    if (!inFile) {
        std::cerr << "Error: Could not open arrivingAnimals.txt" << std::endl;
        return 1;
    }

    std::string line;
    while (std::getline(inFile, line)) {
        // Example line: 4 year old female hyena, born in spring, tan color, 70 pounds, from Friguia Park, Tunisia
        std::stringstream ss(line);
        std::string ageStr, species;
        
        // Simplified parsing logic for practice
        ss >> ageStr; // "4"
        int age = std::stoi(ageStr);
        
        // Logic to find species in the string (simplified)
        if (line.find("hyena") != std::string::npos) {
            zoo.push_back(new Hyena("Unnamed Hyena", age));
            speciesCount["Hyena"]++;
        } else if (line.find("lion") != std::string::npos) {
            zoo.push_back(new Lion("Unnamed Lion", age));
            speciesCount["Lion"]++;
        }
        // ... Repeat for Tiger and Bear
    }
    inFile.close();

    // Generate Report
    std::ofstream outFile("newAnimals.txt");
    outFile << "ZOO POPULATION REPORT\n";
    outFile << "---------------------\n";

    for (auto const& [species, count] : speciesCount) {
        outFile << species << " Habitat (Total: " << count << "):\n";
        for (Animal* animal : zoo) {
            if (animal->getSpecies() == species) {
                outFile << "- " << animal->getName() << "; " 
                        << animal->getAge() << " years old; Origin: " 
                        << animal->getOrigin() << "\n";
            }
        }
        outFile << "\n";
    }

    // Clean up memory
    for (Animal* a : zoo) delete a;

    return 0;
}
